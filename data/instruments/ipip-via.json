    {
      "id": "via-citizenship-teamwork-6",
      "text": "Prefer to do everything alone.",
      "scale": "citizenship-teamwork",
      "reverse": true
    },
    {
      "id": "via-curiosity-6",
      "text": "Think that my life is extremely interesting.",
      "scale": "curiosity",
      "reverse": false
    },
    {
      "id": "via-equity-fairness-6",
      "text": "Am committed to principles of justice and equality.",
      "scale": "equity-fairness",
      "reverse": false
    },
    {
      "id": "via-forgiveness-mercy-6",
      "text": "Hate to see anyone suffer, even my worst enemy.",
      "scale": "forgiveness-mercy",
      "reverse": false
    },
    {
      "id": "via-gratitude-6",
      "text": "Feel a profound sense of appreciation every day.",
      "scale": "gratitude",
      "reverse": false
    },
    {
      "id": "via-hope-optimism-6",
      "text": "Expect the worst.",
      "scale": "hope-optimism",
      "reverse": true
    },
    {
      "id": "via-humor-playfulness-6",
      "text": "Have a great sense of humor.",
      "scale": "humor-playfulness",
      "reverse": false
    },
    {
      "id": "via-industry-perseverance-persistence-6",
      "text": "Don't finish what I start.",
      "scale": "industry-perseverance-persistence",
      "reverse": true
    },
    {
      "id": "via-integrity-honesty-authenticity-6",
      "text": "Lie to get myself out of trouble.",
      "scale": "integrity-honesty-authenticity",
      "reverse": true
    },
    {
      "id": "via-judgment-open-mindedness-6",
      "text": "Try to have good reasons for my important decisions.",
      "scale": "judgment-open-mindedness",
      "reverse": false
    },
    {
      "id": "via-kindness-generosity-6",
      "text": "Call my friends when they are sick.",
      "scale": "kindness-generosity",
      "reverse": false
    },
    {
      "id": "via-leadership-6",
      "text": "Am not good at taking charge of a group.",
      "scale": "leadership",
      "reverse": true
    },
    {
      "id": "via-love-of-learning-6",
      "text": "Consult the library or the Internet immediately if I want to know something.",
      "scale": "love-of-learning",
      "reverse": false
    },
    {
      "id": "via-modesty-humility-6",
      "text": "Don't call attention to myself.",
      "scale": "modesty-humility",
      "reverse": false
    },
    {
      "id": "via-originality-creativity-6",
      "text": "Don't pride myself on being original.",
      "scale": "originality-creativity",
      "reverse": true
    },
    {
      "id": "via-perspective-wisdom-6",
      "text": "Am considered to be a wise person.",
      "scale": "perspective-wisdom",
      "reverse": false
    },
    {
      "id": "via-prudence-6",
      "text": "Avoid activities that are physically dangerous.",
      "scale": "prudence",
      "reverse": false
    },
    {
      "id": "via-self-regulation-self-control-6",
      "text": "Do not exercise on a regular basis.",
      "scale": "self-regulation-self-control",
      "reverse": true
    },
    {
      "id": "via-social-personal-emotional-intelligence-6",
      "text": "Know what to say to make people feel good.",
      "scale": "social-personal-emotional-intelligence",
      "reverse": false
    },
    {
      "id": "via-spirituality-religiousness-6",
      "text": "Believe that each person has a purpose in life.",
      "scale": "spirituality-religiousness",
      "reverse": false
    },
    {
      "id": "via-valor-bravery-courage-6",
      "text": "Am a brave person.",
      "scale": "valor-bravery-courage",
      "reverse": false
    },
    {
      "id": "via-zest-enthusiasm-vitality-6",
      "text": "Can hardly wait to see what life has in store for me in the years ahead.",
      "scale": "zest-enthusiasm-vitality",
      "reverse": false
    },
    {
      "id": "via-appreciation-of-beauty-7",
      "text": "Crave the experience of great art.",
      "scale": "appreciation-of-beauty",
      "reverse": false
    },
    {
      "id": "via-capacity-for-love-7",
      "text": "Do not easily share my feelings with others.",
      "scale": "capacity-for-love",
      "reverse": true
    },
    {
      "id": "via-citizenship-teamwork-7",
      "text": "Work best when I am alone.",
      "scale": "citizenship-teamwork",
      "reverse": true
    },
    {
      "id": "via-curiosity-7",
      "text": "Love to hear about other countries and cultures.",
      "scale": "curiosity",
      "reverse": false
    },
    {
      "id": "via-equity-fairness-7",
      "text": "Believe that everyone should have a say.",
      "scale": "equity-fairness",
      "reverse": false
    },
    {
      "id": "via-forgiveness-mercy-7",
      "text": "Try to respond with understanding when someone treats me badly.",
      "scale": "forgiveness-mercy",
      "reverse": false
    },
    {
      "id": "via-gratitude-7",
      "text": "Do not see the need to acknowledge others who are good to me.",
      "scale": "gratitude",
      "reverse": true
    },
    {
      "id": "via-hope-optimism-7",
      "text": "Have no plan for my life five years from now.",
      "scale": "hope-optimism",
      "reverse": true
    },
    {
      "id": "via-humor-playfulness-7",
      "text": "Am not known for my sense of humor.",
      "scale": "humor-playfulness",
      "reverse": true
    },
    {
      "id": "via-industry-perseverance-persistence-7",
      "text": "Give up easily.",
      "scale": "industry-perseverance-persistence",
      "reverse": true
    },
    {
      "id": "via-integrity-honesty-authenticity-7",
      "text": "Am hard to understand.",
      "scale": "integrity-honesty-authenticity",
      "reverse": true
    },
    {
      "id": "via-judgment-open-mindedness-7",
      "text": "Am valued by my friends for my good judgment.",
      "scale": "judgment-open-mindedness",
      "reverse": false
    },
    {
      "id": "via-kindness-generosity-7",
      "text": "Love to let others share the spotlight.",
      "scale": "kindness-generosity",
      "reverse": false
    },
    {
      "id": "via-leadership-7",
      "text": "Am not good at planning group activities.",
      "scale": "leadership",
      "reverse": true
    },
    {
      "id": "via-love-of-learning-7",
      "text": "Read a large variety of books.",
      "scale": "love-of-learning",
      "reverse": false
    },
    {
      "id": "via-modesty-humility-7",
      "text": "Would never be described as arrogant.",
      "scale": "modesty-humility",
      "reverse": false
    },
    {
      "id": "via-originality-creativity-7",
      "text": "Am not considered to have new and different ideas.",
      "scale": "originality-creativity",
      "reverse": true
    },
    {
      "id": "via-perspective-wisdom-7",
      "text": "Lose sight of what is most important in life.",
      "scale": "perspective-wisdom",
      "reverse": true
    },
    {
      "id": "via-prudence-7",
      "text": "Keep straight right from wrong.",
      "scale": "prudence",
      "reverse": false
    },
    {
      "id": "via-self-regulation-self-control-7",
      "text": "Can't resist eating candy or cookies if they are around.",
      "scale": "self-regulation-self-control",
      "reverse": true
    },
    {
      "id": "via-social-personal-emotional-intelligence-7",
      "text": "Don't know how to handle myself in a new social situation.",
      "scale": "social-personal-emotional-intelligence",
      "reverse": true
    },
    {
      "id": "via-spirituality-religiousness-7",
      "text": "Know that my beliefs make my life important.",
      "scale": "spirituality-religiousness",
      "reverse": false
    },
    {
      "id": "via-valor-bravery-courage-7",
      "text": "Avoid dealing with uncomfortable emotions.",
      "scale": "valor-bravery-courage",
      "reverse": true
    },
    {
      "id": "via-zest-enthusiasm-vitality-7",
      "text": "Awaken with a sense of excitement about the day's possibilities.",
      "scale": "zest-enthusiasm-vitality",
      "reverse": false
    },
    {
      "id": "via-appreciation-of-beauty-8",
      "text": "Fail to notice beauty until others comment on it.",
      "scale": "appreciation-of-beauty",
      "reverse": true
    },
    {
      "id": "via-capacity-for-love-8",
      "text": "Feel isolated from other people.",
      "scale": "capacity-for-love",
      "reverse": true
    },
    {
      "id": "via-citizenship-teamwork-8",
      "text": "Keep to myself.",
      "scale": "citizenship-teamwork",
      "reverse": true
    },
    {
      "id": "via-curiosity-8",
      "text": "Am not all that curious about the world.",
      "scale": "curiosity",
      "reverse": true
    },
    {
      "id": "via-equity-fairness-8",
      "text": "Take advantage of others.",
      "scale": "equity-fairness",
      "reverse": true
    },
    {
      "id": "via-forgiveness-mercy-8",
      "text": "Hold grudges.",
      "scale": "forgiveness-mercy",
      "reverse": true
    },
    {
      "id": "via-gratitude-8",
      "text": "Find few things in my life to be grateful for.",
      "scale": "gratitude",
      "reverse": true
    },
    {
      "id": "via-hope-optimism-8",
      "text": "Am not confident that my way of doing things will work out for the best.",
      "scale": "hope-optimism",
      "reverse": true
    },
    {
      "id": "via-humor-playfulness-8",
      "text": "Am not fun to be with.",
      "scale": "humor-playfulness",
      "reverse": true
    },
    {
      "id": "via-industry-perseverance-persistence-8",
      "text": "Do not tend to stick with what I decide to do.",
      "scale": "industry-perseverance-persistence",
      "reverse": true
    },
    {
      "id": "via-integrity-honesty-authenticity-8",
      "text": "Feel like an imposter.",
      "scale": "integrity-honesty-authenticity",
      "reverse": true
    },
    {
      "id": "via-judgment-open-mindedness-8",
      "text": "Don't think about different possibilities when making decisions.",
      "scale": "judgment-open-mindedness",
      "reverse": true
    },
    {
      "id": "via-kindness-generosity-8",
      "text": "Get impatient when others talk to me about their problems.",
      "scale": "kindness-generosity",
      "reverse": true
    },
    {
      "id": "via-love-of-learning-8",
      "text": "Don't like to learn new things.",
      "scale": "love-of-learning",
      "reverse": true
    },
    {
      "id": "via-modesty-humility-8",
      "text": "Like to stand out in a crowd.",
      "scale": "modesty-humility",
      "reverse": true
    },
    {
      "id": "via-originality-creativity-8",
      "text": "Have no special urge to do something original.",
      "scale": "originality-creativity",
      "reverse": true
    },
    {
      "id": "via-perspective-wisdom-8",
      "text": "Am not good at figuring out what really matters.",
      "scale": "perspective-wisdom",
      "reverse": true
    },
    {
      "id": "via-prudence-8",
      "text": "Make careful choices.",
      "scale": "prudence",
      "reverse": false
    },
    {
      "id": "via-self-regulation-self-control-8",
      "text": "Am not very good at getting things done.",
      "scale": "self-regulation-self-control",
      "reverse": true
    },
    {
      "id": "via-spirituality-religiousness-8",
      "text": "Do not practice any religion.",
      "scale": "spirituality-religiousness",
      "reverse": true
    },
    {
      "id": "via-valor-bravery-courage-8",
      "text": "Avoid dealing with awkward situations.",
      "scale": "valor-bravery-courage",
      "reverse": true
    },
    {
      "id": "via-zest-enthusiasm-vitality-8",
      "text": "Dread getting up in the morning.",
      "scale": "zest-enthusiasm-vitality",
      "reverse": true
    },
    {
      "id": "via-capacity-for-love-9",
      "text": "Have difficulty accepting love from anyone.",
      "scale": "capacity-for-love",
      "reverse": true
    },
    {
      "id": "via-citizenship-teamwork-9",
      "text": "Don’t think it’s important to socialize with others.",
      "scale": "citizenship-teamwork",
      "reverse": true
    },
    {
      "id": "via-curiosity-9",
      "text": "Find it difficult to entertain myself.",
      "scale": "curiosity",
      "reverse": true
    },
    {
      "id": "via-equity-fairness-9",
      "text": "Treat others differently if I don't like them.",
      "scale": "equity-fairness",
      "reverse": true
    },
    {
      "id": "via-forgiveness-mercy-9",
      "text": "Do not give anyone a second chance to hurt me.",
      "scale": "forgiveness-mercy",
      "reverse": true
    },
    {
      "id": "via-humor-playfulness-9",
      "text": "Do not go out of my way to make others smile or laugh.",
      "scale": "humor-playfulness",
      "reverse": true
    },
    {
      "id": "via-integrity-honesty-authenticity-9",
      "text": "Like to exaggerate my troubles.",
      "scale": "integrity-honesty-authenticity",
      "reverse": true
    },
    {
      "id": "via-judgment-open-mindedness-9",
      "text": "Don't tend to think things through critically.",
      "scale": "judgment-open-mindedness",
      "reverse": true
    },
    {
      "id": "via-kindness-generosity-9",
      "text": "Try not to do favors for others.",
      "scale": "kindness-generosity",
      "reverse": true
    },
    {
      "id": "via-love-of-learning-9",
      "text": "Do not like to visit museums.",
      "scale": "love-of-learning",
      "reverse": true
    },
    {
      "id": "via-modesty-humility-9",
      "text": "Like to talk about myself.",
      "scale": "modesty-humility",
      "reverse": true
    },
    {
      "id": "via-perspective-wisdom-9",
      "text": "Am rarely consulted for advice by others.",
      "scale": "perspective-wisdom",
      "reverse": true
    },
    {
      "id": "via-prudence-9",
      "text": "Behave in unusual and strange ways.",
      "scale": "prudence",
      "reverse": true
    },
    {
      "id": "via-self-regulation-self-control-9",
      "text": "Let myself be taken over by urges to spend or eat too much.",
      "scale": "self-regulation-self-control",
      "reverse": true
    },
    {
      "id": "via-spirituality-religiousness-9",
      "text": "Do not believe in a universal power or a God.",
      "scale": "spirituality-religiousness",
      "reverse": true
    },
    {
      "id": "via-valor-bravery-courage-9",
      "text": "Do not stand up for my beliefs.",
      "scale": "valor-bravery-courage",
      "reverse": true
    },
    {
      "id": "via-zest-enthusiasm-vitality-9",
      "text": "Don't have much energy.",
      "scale": "zest-enthusiasm-vitality",
      "reverse": true
    },
    {
      "id": "via-curiosity-10",
      "text": "Have few interests.",
      "scale": "curiosity",
      "reverse": true
    },
    {
      "id": "via-kindness-generosity-10",
      "text": "Am only kind to others if they have been kind to me.",
      "scale": "kindness-generosity",
      "reverse": true
    },
    {
      "id": "via-love-of-learning-10",
      "text": "Don't read nonfiction books for fun.",
      "scale": "love-of-learning",
      "reverse": true
    },
    {
      "id": "via-self-regulation-self-control-10",
      "text": "Do my tasks only just before they need to be done.",
      "scale": "self-regulation-self-control",
      "reverse": true
    },
    {
      "id": "via-valor-bravery-courage-10",
      "text": "Don't speak my mind freely when there might be negative results.",
      "scale": "valor-bravery-courage",
      "reverse": true
    },
    {
      "id": "via-self-regulation-self-control-11",
      "text": "Give in to my urges.",
      "scale": "self-regulation-self-control",
      "reverse": true
    }
